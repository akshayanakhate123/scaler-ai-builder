# Copy this file to `secrets.toml` (same folder) and fill in real values.
# secrets.toml is gitignored — never commit real keys.

GEMINI_API_KEY = "your-gemini-key"
GROQ_API_KEY = "your-groq-key"

# Twilio WhatsApp sandbox
TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# Cloudinary — format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# IMPORTANT: no spaces anywhere in this value.
CLOUDINARY_URL = "cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Your test phone, WhatsApp format
MY_TEST_WHATSAPP = "whatsapp:+91XXXXXXXXXX"
